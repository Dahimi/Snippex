# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Cerebras API
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

# Supabase (for API key validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal service key — shared secret used by the web app playground proxy
# Generate any strong random string: openssl rand -hex 32
INTERNAL_SERVICE_KEY=your_internal_service_key_here

# Upstash Redis — optional, caching is disabled if not set
# Get these from https://console.upstash.com → create a Redis database
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# GCS telemetry — optional, falls back to telemetry_logs.jsonl locally if not set
# Bucket must already exist. Cloud Run uses the service account for auth automatically.
GCS_LOG_BUCKET=your-snippex-logs-bucket

RATE_LIMIT_USER_PER_HOUR=100
STRIPE_SUCCESS_URL="https://snipex.dev/billing/success"
STRIPE_CANCEL_URL="https://snipex.dev/billing/cancel"