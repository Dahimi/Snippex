# ============================================================
# Snipex Web — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Clerk — https://dashboard.clerk.com
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (adjust if you change route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------
# Supabase — https://app.supabase.com
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------
# Snipex backend API
# NEXT_PUBLIC_ prefix makes it available in the browser (for display only).
# Actual API calls go through the /api/search proxy route using SNIPEX_API_URL.
# ------------------------------------------------------------
# Public: shown in dashboard quick-start instructions
NEXT_PUBLIC_SNIPEX_API_URL=http://localhost:8000

# Docs URL — used in Navbar, Footer, and landing page
NEXT_PUBLIC_DOCS_URL=https://docs.snipex.dev

# Pricing config — must match backend CREDITS_PRICE_CENTS, MIN_CREDITS, DEFAULT_FREE_CREDITS
NEXT_PUBLIC_FREE_CREDITS=20
NEXT_PUBLIC_CREDIT_PRICE_CENTS=2
NEXT_PUBLIC_MIN_CREDITS=250

# Server-only: used by the /api/search proxy route (hides the real URL from clients)
# If not set, falls back to NEXT_PUBLIC_SNIPEX_API_URL
SNIPEX_API_URL=http://localhost:8000

# Shared secret between this web server and the backend (must match INTERNAL_SERVICE_KEY in backend .env)
# Generate: openssl rand -hex 32
SNIPEX_INTERNAL_SERVICE_KEY=snipp_ZW5kbGVzcy1kdWNrbGluZy0xOC5jbGVyay5hY2NvdW50cy5kZXYk

# ------------------------------------------------------------
# Upstash Redis — for playground rate limiting
# Use the REST API keys from console.upstash.com (same database as backend)
# ------------------------------------------------------------
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# ------------------------------------------------------------
# Stripe (placeholder — not yet implemented)
# ------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...